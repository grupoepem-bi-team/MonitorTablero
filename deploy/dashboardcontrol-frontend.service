[Unit]
Description=Dashboard Control - Frontend (FastAPI + uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vm-hermes
WorkingDirectory=/opt/dashboardcontrol
ExecStart=/opt/dashboardcontrol/.venv/bin/python -m uvicorn frontend.server:app --host 0.0.0.0 --port 8070
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target