# Copia a .env y ajusta. Requiere pip install python-dotenv.

# ---------------------------------------------------------------------------
# Autenticacion Azure AD / Power BI
# ---------------------------------------------------------------------------
# AZURE_CLIENT_ID: ID de la app registrada en Azure Entra ID.
# Si se deja vacio, el codigo usa un valor fallback de emergencia (app vieja
# con permisos excesivos de ReadWrite.All). Ver AUTH.md para crear una nueva
# app con permisos minimos de lectura y reemplazar este valor.
# AZURE_CLIENT_ID=tu-nuevo-client-id-aqui

# Campos de un intento de migracion a Service Principal (no se usan por ahora):
# TENANT_ID=
# CLIENT_ID=
# CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Alertas push (ntfy)
# ---------------------------------------------------------------------------
# NTFY_ENABLED=1
# NTFY_TOPIC=dashboardmonitorepem
# ALERTAR_SOLO_CRITICOS=1
# NTFY_BASE_URL=https://ntfy.sh

# ---------------------------------------------------------------------------
# Timeout de corrida manual (boton "Actualizar ahora")
# ---------------------------------------------------------------------------
# Segundos maximos al pulsar "Actualizar ahora" en el dashboard (por defecto 900)
# MONITOR_MANUAL_TIMEOUT_SEC=900