# Copia a .env y ajusta. Requiere pip install python-dotenv.

# ---------------------------------------------------------------------------
# Autenticacion Azure AD / Power BI
# ---------------------------------------------------------------------------
# AZURE_CLIENT_ID: ID de la app registrada en Azure Entra ID (OBLIGATORIO).
# El codigo ya NO tiene valor fallback: sin esto, el proceso no arranca.
# AZURE_CLIENT_ID=tu-client-id-aqui

# ---------------------------------------------------------------------------
# Service Principal (opcional: token app-only, sin login humano)
# ---------------------------------------------------------------------------
# Si AZURE_CLIENT_SECRET esta presente, el monitor pide el token como aplicacion
# (no depende de que nadie se loguee) -> sobrevive sin intervencion humana.
# Requiere: permiso de APLICACION Dataset.Read.All + consentimiento admin +
# tenant setting "Service principals can use Power BI APIs" + el SP como Member
# de cada workspace. Ver AUTH.md / el plan de rediseno.
# AZURE_TENANT_ID=655b856c-39c2-4438-9d98-b375b84019a9
# AZURE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Seguridad del panel
# ---------------------------------------------------------------------------
# Exige el token de sesion del panel para POST /api/corrida (default: true).
# El panel deja una cookie y un <meta>; la pagina devuelve el token en la
# cabecera X-CSRF-Token. Poner en false SOLO para diagnostico puntual.
# ACCION_TOKEN_REQUERIDO=true

# ---------------------------------------------------------------------------
# Timeout de corrida manual (boton "Actualizar ahora")
# ---------------------------------------------------------------------------
# Segundos maximos al pulsar "Actualizar ahora" en el dashboard (por defecto 900)
# MONITOR_MANUAL_TIMEOUT_SEC=900

# ---------------------------------------------------------------------------
# Salud del monitor
# ---------------------------------------------------------------------------
# Edad maxima (min) de la ultima corrida para considerarla fresca (default 35)
# SALUD_FRESCURA_MIN=35
# Edad (min) a partir de la cual se considera caido -> healthcheck 503 (default 90)
# SALUD_CAIDO_MIN=90

# ---------------------------------------------------------------------------
# NO HAY AVISOS
# ---------------------------------------------------------------------------
# El monitor NO envia alertas por ningun medio (ntfy, Telegram, navegador).
# La configuracion NTFY_* que existia aca fue retirada: no habia codigo que la
# usara y daba una falsa sensacion de vigilancia. Para avisar algun dia, se
# implementa en el backend (src/), no en el navegador.
